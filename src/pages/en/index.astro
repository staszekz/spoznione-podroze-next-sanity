---
import CollabBand from "@/components/CollabBand.astro";
import ContinentPills from "@/components/ContinentPills.tsx";
import FeaturedStories from "@/components/FeaturedStories.tsx";
import Hero from "@/components/Hero.astro";
import { SITE_DESCRIPTION } from "@/consts";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getHomepageData } from "@/sanity/lib/queries";

const lang = "en" as const;
const data = await getHomepageData(lang);
const defaultId =
	[...data.continents].sort((a, b) => b.postCount - a.postCount)[0]?._id ?? "";
---

<BaseLayout lang={lang} description={SITE_DESCRIPTION.en} altHref="/">
	<Hero
		lang={lang}
		continents={data.continents}
		countries={data.countries}
		defaultId={defaultId}
	/>
	<ContinentPills
		client:load
		continents={data.continents}
		defaultId={defaultId}
	/>
	<FeaturedStories
		client:load
		continents={data.continents}
		stories={data.stories}
		defaultId={defaultId}
		lang={lang}
	/>
	<CollabBand lang={lang} />
</BaseLayout>
