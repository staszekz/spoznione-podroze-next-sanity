---
import { PortableText } from "astro-portabletext";
import SanityImage from "@/components/SanityImage.tsx";
import { ui } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPost } from "@/sanity/lib/queries";

export async function getStaticPaths() {
	const { getPostSlugs } = await import("@/sanity/lib/queries");
	const slugs = await getPostSlugs("en");
	return slugs.map(({ slug, country }) => ({ params: { country, slug } }));
}

const lang = "en" as const;
const slug = Astro.params.slug ?? "";
const post = await getPost(lang, slug);
const meta = [
	post?.readingTime
		? `☕ ${post.readingTime} ${ui[lang]["featured.readingMeta"]}`
		: null,
	post?.photoCount ? `${post.photoCount} ${ui[lang]["featured.photos"]}` : null,
]
	.filter(Boolean)
	.join(" · ");
---

<BaseLayout
	lang={lang}
	title={post?.title}
	description={post?.excerpt ?? post?.title ?? ''}
>
	<article class="mx-auto flex max-w-[720px] flex-col gap-5 py-10 md:py-16">
		<span
			class="font-mono text-[11px] uppercase tracking-[0.08em] text-primary"
		>
			{post?.country?.name}
		</span>
		<h1
			class="font-display text-4xl font-bold leading-[1.06] tracking-[-0.03em] md:text-5xl"
		>
			{post?.title}
		</h1>
		{meta && <span class="font-mono text-xs text-subtle-foreground">{meta}</span>}
		{post?.coverImage?.asset && (
				<div class="overflow-hidden rounded-[18px]">
					<SanityImage
						image={post.coverImage}
						width={1440}
						height={810}
						loading="eager"
						fetchPriority="high"
					/>
				</div>
			)}
		{post?.excerpt && <p class="text-lg leading-[1.55] text-muted-foreground">{post.excerpt}</p>}
		{post?.body && (
				<div class="flex flex-col gap-4 text-base leading-[1.55]">
					<PortableText value={post.body} />
				</div>
			)}
	</article>
</BaseLayout>
