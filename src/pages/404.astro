---
import { ui } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";

const lang = "pl" as const;
---

<BaseLayout
	lang={lang}
	title={ui.pl["notFound.title"]}
	description={ui.pl["notFound.lead"]}
	altHref="/en/"
>
	<section class="flex flex-col items-start gap-4 py-16 md:py-24">
		<span
			class="font-mono text-[11px] uppercase tracking-[0.08em] text-primary"
		>
			404
		</span>
		<h1 class="font-display text-4xl font-bold tracking-[-0.03em] md:text-5xl">
			{ui.pl["notFound.title"]}
		</h1>
		<p class="max-w-[520px] text-lg text-muted-foreground">
			{ui.pl["notFound.lead"]}
		</p>
		<p class="max-w-[520px] text-base text-subtle-foreground">
			{ui.en["notFound.lead"]}
		</p>
		<div class="flex flex-wrap gap-4">
			<a
				href="/"
				class="text-[15px] font-semibold text-primary hover:text-primary-dark"
			>
				{ui.pl["notFound.cta"]}
				→
			</a>
			<a
				href="/en/"
				class="text-[15px] font-semibold text-primary hover:text-primary-dark"
			>
				{ui.en["notFound.cta"]}
				→
			</a>
		</div>
	</section>
</BaseLayout>
