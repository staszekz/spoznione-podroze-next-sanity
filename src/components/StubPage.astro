---
import type { Lang } from "@/i18n/ui";
import { getTranslations } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
	lang: Lang;
	title: string;
	altHref: string;
}

const { lang, title, altHref } = Astro.props;
const t = getTranslations(lang);
---

<BaseLayout lang={lang} title={title} description={title} altHref={altHref}>
	<div class="flex flex-col gap-4 py-16 md:py-24">
		<h1 class="font-display text-4xl font-bold tracking-[-0.03em] md:text-5xl">
			{title}
		</h1>
		<p class="max-w-[440px] text-lg text-muted-foreground">{t('stub.wip')}</p>
	</div>
</BaseLayout>
