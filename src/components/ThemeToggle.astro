---
import { Moon, Sun } from "@lucide/astro";
import type { Lang } from "@/i18n/ui";
import { getTranslations } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const t = getTranslations(Astro.props.lang);
---

<button
	type="button"
	data-theme-toggle
	aria-label={t('theme.toggle')}
	class="flex size-9 items-center justify-center rounded-full border border-border text-nav-foreground transition-colors hover:text-foreground"
>
	<Sun class="size-4 dark:hidden" />
	<Moon class="hidden size-4 dark:block" />
</button>

<script>
for (const button of document.querySelectorAll("[data-theme-toggle]")) {
	button.addEventListener("click", () => {
		const dark = document.documentElement.classList.toggle("dark");
		localStorage.setItem("theme", dark ? "dark" : "light");
		window.dispatchEvent(new CustomEvent("themechange", { detail: { dark } }));
	});
}
</script>
