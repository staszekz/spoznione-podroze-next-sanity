---
import { SITE_TITLE } from "@/consts";
import type { Lang } from "@/i18n/ui";
import { getTranslations } from "@/i18n/ui";

interface Props {
	lang: Lang;
}

const t = getTranslations(Astro.props.lang);
---

<footer class="flex flex-col gap-2.5 border-t border-border py-7 pb-9">
	<div class="flex items-center justify-between">
		<span class="font-display text-sm font-bold md:text-base"
			>{SITE_TITLE}</span
		>
		<span class="font-mono text-[11px] text-subtle-foreground md:text-xs">
			{t('footer.meta')}
		</span>
	</div>
	<span class="font-mono text-[9px] text-faint-foreground md:text-[10px]">
		{t('footer.ai')}
	</span>
</footer>
