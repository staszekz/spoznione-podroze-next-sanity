---
import HeroMap from "@/components/map/HeroMap.tsx";
import type { Lang } from "@/i18n/ui";
import { getTranslations, routes } from "@/i18n/ui";
import type { ContinentSummary, CountryPin } from "@/sanity/lib/queries";

interface Props {
	lang: Lang;
	continents: ContinentSummary[];
	countries: CountryPin[];
	defaultId: string;
}

const { lang, continents, countries, defaultId } = Astro.props;
const t = getTranslations(lang);
---

<section
	class="grid items-center gap-5 py-5 md:grid-cols-[1fr_1.15fr] md:gap-12 md:py-10 md:pb-7"
>
	<div class="flex flex-col gap-3.5 md:gap-[18px]">
		<span
			class="font-mono text-[11px] tracking-[0.1em] text-primary md:text-xs"
		>
			{t('hero.eyebrow')}
		</span>
		<h1
			class="font-display text-[38px] font-bold leading-[1.04] tracking-[-0.03em] md:text-[58px] md:leading-[1.02]"
		>
			{t('hero.title')}
		</h1>
		<p
			class="max-w-[440px] text-base leading-[1.55] text-muted-foreground md:text-lg"
		>
			{t('hero.lead')}
		</p>
		<div class="mt-2 flex gap-3">
			<a
				href="#mapa"
				class="inline-flex items-center gap-2 rounded-full bg-primary px-[26px] py-3.5 text-[15px] font-semibold text-primary-foreground transition-colors hover:bg-primary-dark"
			>
				{t('hero.ctaMap')}
				→
			</a>
			<a
				href={routes[lang].latest}
				class="inline-flex items-center rounded-full border border-border-strong px-[26px] py-3.5 text-[15px] font-semibold text-foreground transition-colors hover:border-foreground"
			>
				{t('hero.ctaLatest')}
			</a>
		</div>
	</div>

	<div
		id="mapa"
		class="relative h-[340px] overflow-hidden rounded-[18px] border border-border md:h-[460px] md:rounded-[22px]"
	>
		<HeroMap
			client:only="react"
			continents={continents}
			countries={countries}
			defaultId={defaultId}
			lang={lang}
		/>
	</div>
</section>
